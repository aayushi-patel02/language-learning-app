# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- LLM provider -----------------------------------------------------------
# Which adapter tutor/llm.py uses: "gemini", "deepseek" or "sarvam".
# Run `python manage.py check_llm` after changing any of this.
LLM_PROVIDER=gemini

# Gemini — https://aistudio.google.com/apikey (free tier, no card required)
# `check_llm --list-models` prints the models your key can actually reach.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# DeepSeek — https://platform.deepseek.com (paid; needs account balance)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Sarvam AI — https://dashboard.sarvam.ai (paid; needs account credit)
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations

# --- App behaviour ----------------------------------------------------------
# Serve pre-cached tutor turns instead of calling the LLM. Deterministic; use
# this as the safety net for the live demo.
DEMO_MODE=false

# Exchanges per practice session before the recap screen.
SESSION_TURN_LIMIT=8

# Pre-seeded learner used instead of building real signup/login.
DEMO_USERNAME=demo

# --- Django -----------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
